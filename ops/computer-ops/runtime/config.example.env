# KAI Computer Operations - configuration example. CONTAINS NO SECRETS.
# Copy to a location outside the repository and fill in per host.
# Every value here is non-sensitive by design; the one real credential (the device
# credential) is stored in the macOS Keychain and is never read from a file.

# --- runtime layout ---------------------------------------------------------
# The harness lives OUTSIDE application source, so an app deploy can never ship it.
KAI_HARNESS_ROOT=/Users/jhonwheeler/kai-harness-runtime
DSH_HOME=/Users/jhonwheeler/kai-harness-runtime/dsh-home

# Suppresses the harness root postinstall that rewrites git hooks in its checkout.
CI=true

# --- per-mission (set by the connector, not by hand) ------------------------
# The workspace a mission is confined to. sandbox-policy.workspaceRoot reads this, so
# an empty value means the harness has no writable root at all.
KAI_TASK_WORKSPACE=/Users/jhonwheeler/kai-harness-runtime/workspaces/<mission-id>

# --- model mode: LOCAL_ONLY -------------------------------------------------
# An OpenAI-compatible endpoint on loopback. Changing this to a non-local address does
# NOT make the session cloud-approved: LOCAL_ONLY is enforced by which overlay file is
# selected, and attestation records the endpoint used.
KAI_LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1
KAI_LOCAL_LLM_MODEL=qwen2.5:7b

# PLACEHOLDER credential for a local endpoint that requires no authentication.
# It is named explicitly rather than omitted because upstream documents that a route
# with no credential reference falls back to pi-ai's ambient discovery, which would
# pick up an unrelated real key (OPENAI_API_KEY and friends) and silently authenticate
# a cloud request under LOCAL_ONLY. NEVER put a real key here.
KAI_LOCAL_LLM_API_KEY=local-no-auth-required

# --- model mode: CLOUD_APPROVED --------------------------------------------
# NOT PROVIDED. Selecting cloud requires a separate overlay file plus an explicit
# operator data-egress consent recorded against the mission. A cloud key must never be
# present in the environment of a LOCAL_ONLY session.
