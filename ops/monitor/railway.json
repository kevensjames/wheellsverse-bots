{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "ops/monitor/Dockerfile"
  },
  "deploy": {
    "startCommand": "python -m ops.monitor.run --cron",
    "cronSchedule": "*/5 * * * *",
    "restartPolicyType": "NEVER",
    "numReplicas": 1
  }
}
