# Cloudflare Pages _headers
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# Sol app pages are served extensionless (/sol, /sol/app, /sol/admin), so the
# /*.html rule above doesn't match them — force revalidation explicitly so
# users always get the latest build, never a stale cached app shell.
/sol
  Cache-Control: no-cache
/sol/app
  Cache-Control: no-cache
/sol/admin
  Cache-Control: no-cache

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/blog/*.html
  Cache-Control: public, max-age=0, must-revalidate
