# Cloudflare Pages _headers
/*.html
  Cache-Control: public, max-age=0, must-revalidate

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/blog/*.html
  Cache-Control: public, max-age=0, must-revalidate

# Split JS/CSS modules — always revalidate after deploy (same policy as *.html)
/sol/app/*
  Cache-Control: public, max-age=0, must-revalidate
