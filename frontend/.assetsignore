# Cloudflare Workers Static Assets — files here (relative to the assets directory,
# frontend/) are NOT uploaded or served. Workers Assets, unlike Pages, uploads
# everything by default, so exclude non-production files explicitly.
# See: https://developers.cloudflare.com/workers/static-assets/binding/#ignoring-assets

# Test suite is committed for CI/local use but must never be served in production.
sol/app/tests/

# Generated test harness (also git-ignored) — embeds the mock API route map.
sol/boot-test.html

# Editor/VCS cruft (Pages excluded these automatically; Workers Assets does not).
**/.DS_Store
**/.git
