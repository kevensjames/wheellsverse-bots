<header class="site-header">
  <a class="logo" href="{{ routes.root_url }}">
    {%- if section.settings.logo != blank -%}
      {{ section.settings.logo | image_url: width: 200 | image_tag: alt: shop.name, loading: 'eager' }}
    {%- else -%}
      {{ section.settings.logo_text | default: shop.name }}
    {%- endif -%}
  </a>
  <nav>
    {%- comment -%}
      Use the Shopify Navigation menu if one is configured.
      Otherwise fall back to a hardcoded menu of the 6 named collections —
      this way the store has a sensible nav out of the box without
      requiring a manual menu setup in Online Store → Navigation.
    {%- endcomment -%}
    {%- if section.settings.menu.links.size > 0 -%}
      {%- for link in section.settings.menu.links -%}
        <a href="{{ link.url }}">{{ link.title }}</a>
      {%- endfor -%}
    {%- else -%}
      <a href="/collections/ai-tools-templates">AI Tools</a>
      <a href="/collections/trading-intelligence">Trading</a>
      <a href="/collections/creators-toolkit">Creator Kit</a>
      <a href="/collections/courses-education">Courses</a>
      <a href="/collections/all">All</a>
    {%- endif -%}
  </nav>
  <a class="cart-link" href="{{ routes.cart_url }}">{{ 'accessibility.cart' | t }} · {{ cart.item_count }}</a>
</header>
{% schema %}
{
  "name": "Header",
  "settings": [
    {"type": "image_picker", "id": "logo", "label": "Logo image"},
    {"type": "text", "id": "logo_text", "label": "Logo text", "default": "WHEELLSVERSE"},
    {"type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu"}
  ],
  "presets": [{"name": "Header"}]
}
{% endschema %}
