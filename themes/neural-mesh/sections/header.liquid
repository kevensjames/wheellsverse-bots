<header class="site-header">
  <a class="logo" href="{{ routes.root_url }}">
    {%- if section.settings.logo != blank -%}
      {{ section.settings.logo | image_url: width: 200 | image_tag: alt: shop.name, loading: 'eager' }}
    {%- else -%}
      {{ section.settings.logo_text | default: shop.name }}
    {%- endif -%}
  </a>
  <nav>
    {%- comment -%}
      Detect whether the Shopify menu is just the default placeholders
      (Home / Catalog / Contact). If so, override with our curated nav.
      If the merchant has built a real menu in Online Store → Navigation,
      we'll respect that.
    {%- endcomment -%}
    {%- assign menu_links = section.settings.menu.links -%}
    {%- assign default_only = false -%}
    {%- if menu_links.size == 0 -%}
      {%- assign default_only = true -%}
    {%- elsif menu_links.size <= 3 -%}
      {%- assign default_only = true -%}
      {%- for link in menu_links -%}
        {%- assign t = link.title | downcase | strip -%}
        {%- unless t == 'home' or t == 'catalog' or t == 'contact' or t == 'all collections' or t == 'shop' -%}
          {%- assign default_only = false -%}
        {%- endunless -%}
      {%- endfor -%}
    {%- endif -%}

    {%- if default_only -%}
      <a href="/collections/viral" style="color:#ff5b6e">🔥 Viral</a>
      <a href="/collections/ai-tools-templates">AI Tools</a>
      <a href="/collections/trading-intelligence">Trading</a>
      <a href="/collections/creators-toolkit">Creator Kit</a>
      <a href="/collections/books">Books</a>
      <a href="/collections/all">All</a>
    {%- else -%}
      {%- for link in menu_links -%}
        <a href="{{ link.url }}">{{ link.title }}</a>
      {%- endfor -%}
    {%- endif -%}
  </nav>
  <a class="cart-link" href="{{ routes.cart_url }}">{{ 'accessibility.cart' | t }} · {{ cart.item_count }}</a>
</header>
{% schema %}
{
  "name": "Header",
  "settings": [
    {"type": "image_picker", "id": "logo", "label": "Logo image"},
    {"type": "text", "id": "logo_text", "label": "Logo text", "default": "WHEELLSVERSE"},
    {"type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu"}
  ],
  "presets": [{"name": "Header"}]
}
{% endschema %}
