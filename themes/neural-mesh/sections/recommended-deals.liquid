{%- comment -%}cache-bust 1777773890{%- endcomment -%}
<section class="deals-wrap">
  <div class="deals-head">
    <span class="deals-eyebrow">🔥 {{ section.settings.eyebrow | default: 'OPERATOR DEALS' }}</span>
    <h2 class="deals-h">{{ section.settings.heading | default: 'Recommended deals' }}</h2>
    <p class="deals-sub">{{ section.settings.subheading | default: 'Bundles, sale items, and value picks. The math has been done — you just buy.' }}</p>
  </div>
  <div class="deals-grid">
    {%- assign coll = collections[section.settings.collection] -%}
    {%- assign limit = section.settings.product_limit | default: 6 -%}
    {%- assign frag_types = "Perfume,Cologne,Body Spray,Body Mist" | split: "," -%}
    {%- assign hidden_vendors = "Wheellsverse,Lybethras Swimwear,Eloura Fusion LLC,Spun Bamboo,Coastline Clothing,GlowHaven,WeloWela" | split: "," -%}
    {%- if coll != blank and coll.products_count > 0 -%}
      {%- assign deal_shown = 0 -%}
      {%- for prod in coll.products -%}
        {%- if deal_shown >= limit -%}{%- break -%}{%- endif -%}
        {%- if prod.type == blank or frag_types contains prod.type -%}{%- continue -%}{%- endif -%}
        {%- if hidden_vendors contains prod.vendor -%}{%- continue -%}{%- endif -%}
        {%- assign discount = 0 -%}
        {%- if prod.compare_at_price > product.price -%}
          {%- assign saved = product.compare_at_price | minus: product.price -%}
          {%- assign discount = saved | times: 100 | divided_by: product.compare_at_price -%}
        {%- elsif prod.tags contains 'bundle' -%}
          {%- assign discount = 13 -%}
        {%- elsif prod.tags contains 'sale' -%}
          {%- assign discount = 20 -%}
        {%- endif -%}
        <a class="deal-card" href="{{ prod.url }}">
          {%- if discount > 0 -%}
            <div class="deal-tag">SAVE {{ discount }}%</div>
          {%- else -%}
            <div class="deal-tag deal-tag-value">VALUE PICK</div>
          {%- endif -%}
          {%- if prod.featured_image -%}
            <img class="deal-img" src="{{ prod.featured_image | image_url: width: 600 }}" alt="{{ prod.title | escape }}" loading="lazy">
          {%- endif -%}
          <div class="deal-info">
            <div class="deal-pt">{{ prod.type | default: 'PRODUCT' }}</div>
            <h3 class="deal-t">{{ prod.title | truncate: 60 }}</h3>
            <div class="deal-price-row">
              <span class="deal-price">{{ prod.price | money }}</span>
              {%- if prod.compare_at_price > product.price -%}
                <span class="deal-was">{{ prod.compare_at_price | money }}</span>
              {%- endif -%}
            </div>
          </div>
        </a>
        {%- assign deal_shown = deal_shown | plus: 1 -%}
      {%- endfor -%}
    {%- else -%}
      {%- comment -%} Auto-pick: anything tagged 'bundle' or 'sale', then fallback to top sellers {%- endcomment -%}
      {%- assign shown = 0 -%}
      {%- for prod in collections['operator-picks'].products -%}
        {%- if prod.type == blank or frag_types contains prod.type -%}{%- continue -%}{%- endif -%}
        {%- if hidden_vendors contains prod.vendor -%}{%- continue -%}{%- endif -%}
        {%- if product.tags contains 'bundle' or product.tags contains 'sale' or product.compare_at_price > product.price -%}
          <a class="deal-card" href="{{ prod.url }}">
            <div class="deal-tag">{% if product.tags contains 'bundle' %}BUNDLE{% else %}SALE{% endif %}</div>
            {%- if prod.featured_image -%}
              <img class="deal-img" src="{{ prod.featured_image | image_url: width: 600 }}" alt="{{ prod.title | escape }}" loading="lazy">
            {%- endif -%}
            <div class="deal-info">
              <div class="deal-pt">{{ prod.type | default: 'PRODUCT' }}</div>
              <h3 class="deal-t">{{ prod.title | truncate: 60 }}</h3>
              <div class="deal-price-row">
                <span class="deal-price">{{ prod.price | money }}</span>
              </div>
            </div>
          </a>
          {%- assign shown = shown | plus: 1 -%}
          {%- if shown >= limit -%}{%- break -%}{%- endif -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endif -%}
  </div>
</section>
<style>
  .deals-wrap { max-width: 1280px; margin: 60px auto; padding: 0 24px; }
  .deals-head { margin-bottom: 28px; max-width: 620px; }
  .deals-eyebrow { font-family: Orbitron, sans-serif; font-size: 11px; letter-spacing: 2px; color: #ff5b6e; text-transform: uppercase; }
  .deals-h { font-family: Orbitron, sans-serif; font-size: clamp(28px, 4vw, 44px); margin: 4px 0 8px; letter-spacing: -.5px; background: linear-gradient(180deg, #fff, #ff5b6e 70%); background-clip: text; -webkit-background-clip: text; color: transparent; }
  .deals-sub { color: var(--muted); font-size: 14px; line-height: 1.55; }
  .deals-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 14px; }
  .deal-card { background: rgba(15, 23, 42, .55); backdrop-filter: blur(14px); border: 1px solid rgba(255, 91, 110, .22); border-radius: 14px; overflow: hidden; text-decoration: none; color: var(--text); position: relative; transition: transform .25s, border-color .25s; }
  .deal-card:hover { transform: translateY(-3px); border-color: #ff5b6e; }
  .deal-tag { position: absolute; top: 10px; right: 10px; background: linear-gradient(90deg, #ff5b6e, #f43f5e); color: white; font-family: Orbitron, sans-serif; font-size: 9px; font-weight: 700; letter-spacing: 1px; padding: 4px 8px; border-radius: 6px; z-index: 2; }
  .deal-tag-value { background: linear-gradient(90deg, var(--accent), var(--accent2)); color: var(--bg); }
  .deal-img { width: 100%; height: 180px; object-fit: cover; display: block; background: var(--panel); }
  .deal-info { padding: 14px; }
  .deal-pt { font-family: Orbitron, sans-serif; font-size: 9px; letter-spacing: 1.8px; color: #ff5b6e; text-transform: uppercase; }
  .deal-t { font-size: 13px; font-weight: 600; margin: 6px 0 10px; line-height: 1.3; min-height: 34px; }
  .deal-price-row { display: flex; align-items: baseline; gap: 8px; }
  .deal-price { font-family: Orbitron, sans-serif; font-size: 17px; font-weight: 700; color: #ff5b6e; }
  .deal-was { color: var(--muted); text-decoration: line-through; font-size: 12px; }
</style>
{% schema %}
{
  "name": "Recommended Deals",
  "settings": [
    {"type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "OPERATOR DEALS"},
    {"type": "text", "id": "heading", "label": "Heading", "default": "Recommended deals"},
    {"type": "textarea", "id": "subheading", "label": "Subheading", "default": "Bundles, sale items, and value picks. The math has been done — you just buy."},
    {"type": "collection", "id": "collection", "label": "Collection (leave empty to auto-detect bundles + sales)"},
    {"type": "range", "id": "product_limit", "label": "Number to show", "min": 4, "max": 12, "step": 2, "default": 6}
  ],
  "presets": [{"name": "Recommended Deals"}]
}
{% endschema %}
