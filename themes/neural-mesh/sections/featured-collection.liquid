{%- comment -%}featured-collection v4 (final filter){%- endcomment -%}
<div class="section-title">{{ section.settings.eyebrow | default: "FEATURED" }}</div>
<h2 class="section-h2">{{ section.settings.heading | default: "Latest drops" }}</h2>
<div class="product-grid">
  {%- assign collection = collections[section.settings.collection] -%}
  {%- assign limit = section.settings.product_limit -%}
  {%- assign shown = 0 -%}
  {%- for prod in collection.products -%}
    {%- if shown >= limit -%}{%- break -%}{%- endif -%}
    {%- assign pt = prod.type -%}
    {%- if pt == blank or pt == 'Perfume' or pt == 'Cologne' or pt == 'Body Spray' or pt == 'Body Mist' -%}{%- continue -%}{%- endif -%}
    {%- assign vd = prod.vendor -%}
    {%- if vd == "Wheellsverse" or vd == "Lybethras Swimwear" or vd == 'Eloura Fusion LLC' or vd == 'Spun Bamboo' or vd == 'Coastline Clothing' or vd == 'GlowHaven' or vd == 'WeloWela' -%}{%- continue -%}{%- endif -%}
    {%- render 'card-product', product: prod -%}
    {%- assign shown = shown | plus: 1 -%}
  {%- else -%}
    {%- for prod in collections['operator-picks'].products -%}
      {%- if shown >= limit -%}{%- break -%}{%- endif -%}
      {%- assign pt = prod.type -%}
      {%- if pt == blank or pt == 'Perfume' or pt == 'Cologne' or pt == 'Body Spray' or pt == 'Body Mist' -%}{%- continue -%}{%- endif -%}
      {%- assign vd = prod.vendor -%}
      {%- if vd == "Wheellsverse" or vd == "Lybethras Swimwear" or vd == 'Eloura Fusion LLC' or vd == 'Spun Bamboo' or vd == 'Coastline Clothing' or vd == 'GlowHaven' or vd == 'WeloWela' -%}{%- continue -%}{%- endif -%}
      {%- render 'card-product', product: prod -%}
      {%- assign shown = shown | plus: 1 -%}
    {%- endfor -%}
  {%- endfor -%}
</div>
{% schema %}
{
  "name": "Featured collection",
  "settings": [
    {"type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "FEATURED"},
    {"type": "text", "id": "heading", "label": "Heading", "default": "Latest drops"},
    {"type": "collection", "id": "collection", "label": "Collection"},
    {"type": "range", "id": "product_limit", "label": "Products to show", "min": 4, "max": 24, "step": 2, "default": 8}
  ],
  "presets": [{"name": "Featured collection"}]
}
{% endschema %}
