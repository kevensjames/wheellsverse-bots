<div class="section-title">CATALOG</div>
<h2 class="section-h2">{{ collection.title }}</h2>
{%- if collection.description != blank -%}<div class="hero" style="padding:20px 24px"><p>{{ collection.description }}</p></div>{%- endif -%}
<div class="product-grid">
  {%- paginate collection.products by 24 -%}
    {%- for product in collection.products -%}
      {%- render 'card-product', product: product -%}
    {%- endfor -%}
    {%- if paginate.pages > 1 -%}
      <div style="grid-column:1/-1;text-align:center;margin-top:20px">
        {%- if paginate.previous -%}<a class="btn-ghost" href="{{ paginate.previous.url }}">{{ 'general.pagination.previous' | t }}</a>{%- endif -%}
        {%- if paginate.next -%}<a class="btn-ghost" href="{{ paginate.next.url }}">{{ 'general.pagination.next' | t }}</a>{%- endif -%}
      </div>
    {%- endif -%}
  {%- endpaginate -%}
</div>
{% schema %}
{"name": "Collection", "settings": []}
{% endschema %}
