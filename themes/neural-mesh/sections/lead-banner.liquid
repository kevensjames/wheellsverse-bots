<section class="lead-banner">
  <div class="lead-inner">
    <div class="lead-eyebrow">{{ section.settings.eyebrow | default: '⚡ FEATURED OFFER' }}</div>
    <h2 class="lead-h">{{ section.settings.heading | default: 'AI Stock Alerts — $19/mo' }}</h2>
    <p class="lead-sub">{{ section.settings.subheading | default: 'Daily AI-curated trade signals across stocks + crypto. New members get 7 days free. Cancel anytime.' }}</p>
    <a class="lead-cta" href="{{ section.settings.cta_link | default: '/products/ai-stock-crypto-alerts-19-month' }}">
      {{ section.settings.cta_text | default: 'START 7-DAY FREE TRIAL →' }}
    </a>
    <div class="lead-trust">
      <span>✓ Cancel anytime</span>
      <span>✓ Daily picks</span>
      <span>✓ Used by 1,000+ operators</span>
    </div>
  </div>
</section>
<style>
  .lead-banner { padding: 60px 24px; max-width: 1100px; margin: 40px auto; background: linear-gradient(135deg, rgba(34,211,238,.08), rgba(59,130,246,.08)); border: 1px solid rgba(34,211,238,.25); border-radius: 24px; position: relative; overflow: hidden; }
  .lead-banner::before { content: ''; position: absolute; inset: 0; background: radial-gradient(circle at 30% 20%, rgba(34,211,238,.1), transparent 50%); pointer-events: none; }
  .lead-inner { position: relative; z-index: 1; text-align: center; }
  .lead-eyebrow { font-family: Orbitron, sans-serif; font-size: 11px; letter-spacing: 2px; color: var(--accent); text-transform: uppercase; margin-bottom: 12px; }
  .lead-h { font-family: Orbitron, sans-serif; font-size: clamp(28px, 4vw, 48px); margin: 0 0 14px; background: linear-gradient(180deg, #fff, var(--accent)); background-clip: text; -webkit-background-clip: text; color: transparent; }
  .lead-sub { color: var(--muted); max-width: 560px; margin: 0 auto 28px; line-height: 1.55; font-size: 15px; }
  .lead-cta { display: inline-block; padding: 16px 36px; background: linear-gradient(90deg, var(--accent), var(--accent2)); color: var(--bg); font-weight: 700; font-family: Orbitron, sans-serif; letter-spacing: 1.5px; text-decoration: none; border-radius: 12px; transition: all .15s; box-shadow: 0 0 40px rgba(34,211,238,.25); }
  .lead-cta:hover { transform: translateY(-2px); box-shadow: 0 0 60px rgba(34,211,238,.45); }
  .lead-trust { display: flex; gap: 22px; justify-content: center; margin-top: 24px; flex-wrap: wrap; color: var(--muted); font-size: 12px; letter-spacing: .5px; }
  .lead-trust span { color: var(--accent); }
</style>
{% schema %}
{
  "name": "Lead Banner",
  "settings": [
    {"type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "⚡ FEATURED OFFER"},
    {"type": "text", "id": "heading", "label": "Heading", "default": "AI Stock Alerts — $19/mo"},
    {"type": "textarea", "id": "subheading", "label": "Subheading", "default": "Daily AI-curated trade signals across stocks + crypto. New members get 7 days free. Cancel anytime."},
    {"type": "text", "id": "cta_text", "label": "CTA text", "default": "START 7-DAY FREE TRIAL →"},
    {"type": "url", "id": "cta_link", "label": "CTA link"}
  ],
  "presets": [{"name": "Lead Banner"}]
}
{% endschema %}
