{%- comment -%}
  bundle-widget.liquid — "Frequently bought together"
  Picks the 2 top recommended products + the current one. Renders three
  cards in a row with a "+" separator and a single "Add all 3 to cart" CTA.
  Hides if recommendations API returns nothing.
{%- endcomment -%}
{%- assign recs = recommendations.products -%}
{%- if recs.size >= 2 -%}
  {%- assign rec1 = recs[0] -%}
  {%- assign rec2 = recs[1] -%}
  {%- assign total_cents = product.price | plus: rec1.price | plus: rec2.price -%}
  {%- assign rec1_var = rec1.selected_or_first_available_variant.id -%}
  {%- assign rec2_var = rec2.selected_or_first_available_variant.id -%}
  {%- assign cur_var = product.selected_or_first_available_variant.id -%}
<section class="fbt-wrap">
  <h2 class="fbt-h">Frequently bought together</h2>
  <div class="fbt-row">
    <a class="fbt-card" href="{{ product.url }}">
      <img src="{{ product.featured_image | image_url: width: 200 }}" alt="{{ product.title | escape }}" loading="lazy">
      <div class="fbt-card-info">
        <span class="fbt-card-title">{{ product.title | truncate: 40 }}</span>
        <span class="fbt-card-price">{{ product.price | money }}</span>
      </div>
    </a>
    <span class="fbt-plus" aria-hidden="true">+</span>
    <a class="fbt-card" href="{{ rec1.url }}">
      <img src="{{ rec1.featured_image | image_url: width: 200 }}" alt="{{ rec1.title | escape }}" loading="lazy">
      <div class="fbt-card-info">
        <span class="fbt-card-title">{{ rec1.title | truncate: 40 }}</span>
        <span class="fbt-card-price">{{ rec1.price | money }}</span>
      </div>
    </a>
    <span class="fbt-plus" aria-hidden="true">+</span>
    <a class="fbt-card" href="{{ rec2.url }}">
      <img src="{{ rec2.featured_image | image_url: width: 200 }}" alt="{{ rec2.title | escape }}" loading="lazy">
      <div class="fbt-card-info">
        <span class="fbt-card-title">{{ rec2.title | truncate: 40 }}</span>
        <span class="fbt-card-price">{{ rec2.price | money }}</span>
      </div>
    </a>
  </div>
  <div class="fbt-actions">
    <div class="fbt-total">
      <span class="fbt-total-label">Bundle total</span>
      <span class="fbt-total-price">{{ total_cents | money }}</span>
    </div>
    <button type="button" class="btn btn-primary fbt-add" data-bundle-ids="{{ cur_var }},{{ rec1_var }},{{ rec2_var }}">
      Add all 3 to cart
    </button>
  </div>
</section>
<style>
  .fbt-wrap { max-width: 1280px; margin: 50px auto; padding: 24px; background: rgba(15, 23, 42, .45); border: 1px solid rgba(34, 211, 238, .15); border-radius: 16px; }
  .fbt-h { font-family: Orbitron, sans-serif; font-size: 20px; margin: 0 0 18px; letter-spacing: -.3px; }
  .fbt-row { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; }
  .fbt-card { flex: 1 1 200px; min-width: 200px; display: flex; gap: 12px; align-items: center; padding: 12px; border: 1px solid rgba(34, 211, 238, .12); border-radius: 10px; text-decoration: none; color: var(--text); transition: border-color .15s; }
  .fbt-card:hover { border-color: var(--accent); }
  .fbt-card img { width: 64px; height: 64px; object-fit: cover; border-radius: 6px; flex-shrink: 0; }
  .fbt-card-info { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
  .fbt-card-title { font-size: 13px; line-height: 1.3; }
  .fbt-card-price { font-family: Orbitron, sans-serif; color: var(--accent); font-weight: 700; font-size: 13px; }
  .fbt-plus { font-family: Orbitron, sans-serif; font-size: 24px; color: var(--accent); font-weight: 700; opacity: .6; }
  .fbt-actions { display: flex; justify-content: space-between; align-items: center; gap: 14px; flex-wrap: wrap; margin-top: 18px; padding-top: 18px; border-top: 1px solid rgba(34, 211, 238, .12); }
  .fbt-total { display: flex; flex-direction: column; gap: 2px; }
  .fbt-total-label { font-size: 11px; letter-spacing: 1.5px; color: var(--muted); text-transform: uppercase; font-family: Orbitron, sans-serif; }
  .fbt-total-price { font-family: Orbitron, sans-serif; font-size: 24px; color: var(--accent); font-weight: 700; }
  .fbt-add { padding: 12px 24px; }
  @media (max-width: 600px) {
    .fbt-row { flex-direction: column; align-items: stretch; }
    .fbt-plus { transform: rotate(90deg); align-self: center; }
    .fbt-card { flex: none; }
  }
</style>
<script>
  (function(){
    var btn = document.querySelector('.fbt-add');
    if (!btn) return;
    btn.addEventListener('click', async function(){
      btn.disabled = true;
      var ids = (btn.dataset.bundleIds || '').split(',').filter(Boolean);
      var items = ids.map(function(id){ return {id: parseInt(id, 10), quantity: 1}; });
      try {
        var resp = await fetch('/cart/add.js', {
          method: 'POST',
          headers: {'Content-Type': 'application/json', 'Accept': 'application/json'},
          body: JSON.stringify({items: items})
        });
        if (!resp.ok) throw new Error('add failed');
        window.location.href = '/cart';
      } catch (e) {
        btn.disabled = false;
        btn.textContent = 'Try again';
      }
    });
  })();
</script>
{%- endif -%}
