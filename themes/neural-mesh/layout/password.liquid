<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{{ shop.name }} — Coming soon</title>
  {{ content_for_header }}
  {{ 'theme.css' | asset_url | stylesheet_tag }}
</head>
<body class="t-neural">
  <canvas class="bg" id="neural-canvas"></canvas>
  <div style="max-width:560px;margin:160px auto;padding:0 24px;text-align:center;position:relative;z-index:1">
    <h1 style="font-family:Orbitron,sans-serif;font-size:clamp(36px,5vw,56px);background:linear-gradient(180deg,#fff,#22d3ee);background-clip:text;-webkit-background-clip:text;color:transparent">{{ shop.name }}</h1>
    <p style="color:var(--muted);margin:16px 0 32px">Something is being engineered. Enter password to access.</p>
    {%- form 'storefront_password' -%}
      {{ form.errors | default_errors }}
      <input type="password" name="password" placeholder="Password" style="background:var(--panel);color:var(--text);border:1px solid rgba(34,211,238,.25);border-radius:10px;padding:14px;font-size:15px;width:100%;max-width:320px;font-family:inherit">
      <button type="submit" class="btn" style="margin-left:8px">Enter</button>
    {%- endform -%}
  </div>
  <script src="{{ 'theme.js' | asset_url }}" defer></script>
</body>
</html>
