<div class="form-page"><h1>Reset password</h1>{% form 'reset_customer_password' %}{{ form.errors | default_errors }}<div class="field"><label>New password</label><input type="password" name="customer[password]" required></div><div class="field"><label>Confirm</label><input type="password" name="customer[password_confirmation]" required></div><button type="submit" class="btn">Reset</button>{% endform %}</div>