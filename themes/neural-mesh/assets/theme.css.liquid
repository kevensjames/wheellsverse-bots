/* WheellsVerse · Neural-Mesh Theme · v1.0 */
:root {
  --bg: {{ settings.color_bg | default: "#040816" }};
  --panel: {{ settings.color_panel | default: "#0f172a" }};
  --text: {{ settings.color_text | default: "#e6edff" }};
  --muted: {{ settings.color_muted | default: "#94a3b8" }};
  --accent: {{ settings.color_accent | default: "#22d3ee" }};
  --accent2: {{ settings.color_accent2 | default: "#3b82f6" }};
}
* { box-sizing: border-box; }
html, body { margin: 0; padding: 0; }
body.t-neural {
  background: var(--bg);
  color: var(--text);
  font-family: Inter, system-ui, sans-serif;
  position: relative;
  min-height: 100vh;
  overflow-x: hidden;
}
body.t-neural canvas.bg {
  position: fixed; inset: 0; z-index: 0; opacity: .6; pointer-events: none;
}
.skip-link { position: absolute; left: -9999px; }
.skip-link:focus { left: 16px; top: 16px; padding: 8px 14px; background: var(--accent); color: var(--bg); border-radius: 8px; z-index: 10000; }
main { position: relative; z-index: 1; }

/* Buttons */
.btn { display: inline-block; padding: 14px 30px; background: linear-gradient(90deg, var(--accent), var(--accent2)); color: var(--bg); font-weight: 700; font-family: Orbitron, sans-serif; letter-spacing: 1px; text-transform: uppercase; border: 0; border-radius: 12px; text-decoration: none; cursor: pointer; transition: transform .15s, box-shadow .15s; }
.btn:hover { transform: translateY(-2px); box-shadow: 0 0 40px rgba(34, 211, 238, .3); }
.btn-ghost { display: inline-block; padding: 12px 24px; border: 1px solid rgba(34, 211, 238, .35); border-radius: 10px; color: var(--text); text-decoration: none; font-size: 13px; transition: all .15s; }
.btn-ghost:hover { border-color: var(--accent); color: var(--accent); }

/* Header */
.site-header { position: relative; z-index: 5; padding: 20px 28px; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid rgba(34, 211, 238, .08); backdrop-filter: blur(8px); background: rgba(4, 8, 22, .55); }
.site-header .logo { font-family: Orbitron, sans-serif; font-weight: 700; letter-spacing: 3px; font-size: 18px; background: linear-gradient(90deg, var(--accent), var(--accent2)); background-clip: text; -webkit-background-clip: text; color: transparent; text-decoration: none; }
.site-header .logo img { max-height: 40px; vertical-align: middle; }
.site-header nav a { color: var(--muted); text-decoration: none; margin-left: 22px; font-size: 13px; letter-spacing: .5px; transition: color .15s; }
.site-header nav a:hover { color: var(--accent); }
.site-header .cart-link { color: var(--accent); text-decoration: none; padding: 8px 14px; border: 1px solid rgba(34, 211, 238, .3); border-radius: 999px; font-size: 12px; letter-spacing: .5px; }

/* Hero */
.hero { padding: 90px 24px 110px; text-align: center; }
.hero h1 { font-family: Orbitron, sans-serif; font-size: clamp(40px, 7vw, 88px); line-height: 1.05; font-weight: 700; margin: 0; letter-spacing: -1px; background: linear-gradient(180deg, #fff 0%, var(--accent) 60%, var(--accent2) 100%); background-clip: text; -webkit-background-clip: text; color: transparent; }
.hero p { color: var(--muted); max-width: 640px; margin: 26px auto; font-size: 18px; line-height: 1.55; }

/* Product grid */
.product-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 20px; max-width: 1280px; margin: 0 auto; padding: 40px 24px; }
.product-card { background: rgba(15, 23, 42, .6); backdrop-filter: blur(14px); border: 1px solid rgba(34, 211, 238, .18); border-radius: 18px; overflow: hidden; transition: transform .25s, border-color .25s, box-shadow .25s; position: relative; text-decoration: none; color: inherit; display: block; }
.product-card::before { content: ''; position: absolute; top: 0; left: -50%; width: 200%; height: 1px; background: linear-gradient(90deg, transparent, var(--accent), transparent); animation: shimmer 3s infinite; opacity: .6; }
@keyframes shimmer { 0% { transform: translateX(-50%); } 100% { transform: translateX(50%); } }
.product-card:hover { transform: translateY(-4px); border-color: rgba(34, 211, 238, .55); box-shadow: 0 0 40px rgba(34, 211, 238, .2); }
.product-card .card-image-wrap { position: relative; overflow: hidden; }
.product-card .card-image { width: 100%; height: 240px; object-fit: cover; display: block; background: var(--panel); transition: transform .35s ease; }
.product-card:hover .card-image { transform: scale(1.04); }
.product-card .card-image--placeholder { display: flex; align-items: center; justify-content: center; color: var(--muted); }
.product-card .card-info { padding: 16px 18px 18px; display: flex; flex-direction: column; gap: 6px; }
.product-card .card-meta, .product-card .pt { font-family: Orbitron, sans-serif; font-size: 10px; letter-spacing: 2px; color: var(--accent); text-transform: uppercase; }
.product-card .card-title, .product-card h3 { font-size: 14px; font-weight: 600; margin: 4px 0 2px; line-height: 1.35; min-height: 38px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.product-card .card-price-row { display: flex; align-items: baseline; gap: 8px; margin-top: 4px; }
.product-card .card-price, .product-card .price { font-family: Orbitron, sans-serif; font-size: 18px; color: var(--accent); font-weight: 700; }
.product-card .card-was { font-size: 12px; color: var(--muted); text-decoration: line-through; }
.product-card .card-fulfill { font-size: 11px; color: #34d399; margin-top: 2px; }
.product-card .card-badge { position: absolute; top: 10px; padding: 4px 9px; border-radius: 6px; font-family: Orbitron, sans-serif; font-size: 10px; font-weight: 700; letter-spacing: .8px; z-index: 2; pointer-events: none; }
.product-card .card-badge--sale { left: 10px; background: linear-gradient(90deg, #ff5b6e, #f43f5e); color: white; }
.product-card .card-badge--instant { right: 10px; background: rgba(15, 23, 42, .85); border: 1px solid rgba(52, 211, 153, .55); color: #34d399; }

/* Section title */
.section-title { font-family: Orbitron, sans-serif; font-size: 12px; letter-spacing: 3px; color: var(--muted); text-transform: uppercase; max-width: 1280px; margin: 50px auto 14px; padding: 0 24px; }
.section-h2 { font-family: Orbitron, sans-serif; font-size: clamp(28px, 4vw, 44px); margin: 0 auto; max-width: 1280px; padding: 0 24px 20px; line-height: 1.1; }

/* Product page */
.product { max-width: 1280px; margin: 40px auto; padding: 0 24px; display: grid; grid-template-columns: 1.1fr 1fr; gap: 50px; }
@media (max-width: 800px) { .product { grid-template-columns: 1fr; gap: 30px; } }
.product-media img { width: 100%; border-radius: 18px; border: 1px solid rgba(34, 211, 238, .2); }
.product-media .thumbs { display: flex; gap: 10px; margin-top: 14px; flex-wrap: wrap; }
.product-media .thumbs img { width: 70px; height: 70px; object-fit: cover; border-radius: 8px; cursor: pointer; opacity: .6; transition: opacity .15s, border-color .15s; }
.product-media .thumbs img:hover, .product-media .thumbs img.active { opacity: 1; border-color: var(--accent); }
.product-info h1 { font-family: Orbitron, sans-serif; font-size: clamp(28px, 3.5vw, 40px); line-height: 1.1; margin: 0 0 8px; letter-spacing: -.5px; }
.product-info .price { font-family: Orbitron, sans-serif; font-size: 28px; color: var(--accent); font-weight: 700; margin: 16px 0; }
.product-info .desc { color: var(--muted); line-height: 1.6; margin: 20px 0; }
.product-info select, .product-info input { background: var(--panel); color: var(--text); border: 1px solid rgba(34, 211, 238, .25); border-radius: 8px; padding: 12px 14px; font-family: inherit; font-size: 14px; width: 100%; max-width: 260px; }

/* Cart */
.cart-page { max-width: 960px; margin: 60px auto; padding: 0 24px; }
.cart-page h1 { font-family: Orbitron, sans-serif; }
.cart-items { background: rgba(15, 23, 42, .5); border: 1px solid rgba(34, 211, 238, .15); border-radius: 16px; padding: 18px; }
.cart-row { display: grid; grid-template-columns: 80px 1fr auto auto; gap: 14px; align-items: center; padding: 16px 0; border-bottom: 1px solid rgba(34, 211, 238, .08); }
.cart-row:last-child { border: 0; }
.cart-row img { width: 80px; height: 80px; object-fit: cover; border-radius: 8px; }
.cart-totals { margin-top: 24px; text-align: right; font-family: Orbitron, sans-serif; }
.cart-totals .total { font-size: 24px; color: var(--accent); }

/* Footer */
.site-footer { padding: 60px 24px 40px; border-top: 1px solid rgba(34, 211, 238, .08); margin-top: 80px; text-align: center; }
.site-footer .links { margin-bottom: 16px; }
.site-footer .links a { color: var(--muted); margin: 0 14px; text-decoration: none; font-size: 13px; }
.site-footer .links a:hover { color: var(--accent); }
.site-footer .cr { color: var(--muted); font-size: 12px; opacity: .7; }

/* Forms (login, register) */
.form-page { max-width: 460px; margin: 80px auto; padding: 0 24px; }
.form-page h1 { font-family: Orbitron, sans-serif; text-align: center; margin: 0 0 28px; }
.form-page .field { margin-bottom: 16px; }
.form-page label { display: block; font-size: 12px; color: var(--muted); margin-bottom: 6px; letter-spacing: 1px; text-transform: uppercase; }
.form-page input { width: 100%; background: var(--panel); color: var(--text); border: 1px solid rgba(34, 211, 238, .25); border-radius: 8px; padding: 14px; font-size: 14px; font-family: inherit; }
.form-page input:focus { outline: 0; border-color: var(--accent); box-shadow: 0 0 0 3px rgba(34, 211, 238, .15); }

/* Announcement bar */
.announcement-bar { background: var(--panel); color: var(--accent); text-align: center; padding: 8px; font-size: 12px; letter-spacing: 1.5px; text-transform: uppercase; border-bottom: 1px solid rgba(34, 211, 238, .15); }
