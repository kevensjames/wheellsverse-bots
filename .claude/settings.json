{
  "permissions": {
    "allow": [
      "Bash(python marketing_autopilot.py *)",
      "Bash(python3 marketing_autopilot.py *)",
      "Bash(source venv/bin/activate*)",
      "Bash(pip install *)",
      "Bash(pip3 install *)",
      "Bash(cat output/*)",
      "Bash(ls *)",
      "Bash(ls)",
      "Bash(cd /Volumes/Wheellsverse/narai_marketing*)",
      "Bash(mkdir -p *)",
      "Bash(cp *)",
      "Bash(python3 -m venv *)",
      "Bash(python -m venv *)",
      "Bash(python -c *)",
      "Bash(python3 -c *)",
      "Bash(source /Volumes/Wheellsverse/narai_marketing/venv/bin/activate*)",
      "Bash(launchctl *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/scripts/hooks/pre-commit-scan.sh"
          }
        ]
      }
    ]
  }
}
