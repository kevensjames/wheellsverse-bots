semgrep-staged.json

# Local backups (env, asset registries)
*.backup.json
.env.bak.*
# Date-suffixed registry/queue snapshots (e.g. *.bak.20260503_233939).
# The existing *.bak pattern misses these because the .bak comes mid-name.
data/*.bak.*

# venv symlink at repo root — convenience pointer to .venv. Line 24's
# `venv/` pattern matches a directory; this catches the symlink form,
# anchored to root so a deeper `venv` dir (if one ever exists) is unaffected.
/venv

# Hook caches (claude-secure-defaults, etc.)
semgrep-mcp/

# Heavy doc assets — keep .md, drop screenshots
docs/screenshots/

# Mac mini migration — per-machine customization + encrypted secrets bundles
scripts/mac-mini/CUSTOMIZE.sh
wheellsverse-secrets-*.tar.gz.gpg

# Daily-generated blog archive
frontend/blog/_archive/

# Daily-generated published blogs (keep curated landing pages)
# Uncomment after auditing which posts are hand-curated:
# frontend/blog/*.html
# !frontend/blog/index.html

