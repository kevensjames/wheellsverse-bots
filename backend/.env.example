# Copy this to .env and fill in real values.

# App
APP_NAME=Wheellsverse
APP_ENV=development
DEBUG=true

# Database — create with: createdb wheellsverse_dev
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wheellsverse_dev

# Redis (shared)
REDIS_URL=redis://localhost:6379/0

# JWT — generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=change_me_to_a_long_random_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Admin API token — guards the entire /admin surface (journals, persona,
# relationship data, Sol money admin). REQUIRED in production: the app refuses
# to boot on a missing/short/default token (>= 32 chars).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Market data ingestion
MARKET_DATA_FETCH_INTERVAL_MINUTES=15
MARKET_DATA_LOOKBACK_DAYS=30
MARKET_DATA_BATCH_SIZE=10
YFINANCE_REQUEST_DELAY_SECONDS=0.5

# Predictions (Stage 4)
STOCK_PREDICTION_INTERVAL_MINUTES=60
CRYPTO_PREDICTION_INTERVAL_MINUTES=60
STOCK_PREDICTION_HORIZON_HOURS=24
CRYPTO_PREDICTION_HORIZON_HOURS=24
MIN_PRICE_HISTORY_ROWS=200
MODEL_VERSION=rules-v1

# Stripe billing (Stage 5) — use test-mode keys for local dev (sk_test_...)
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
# Create Products in Stripe → grab the Price IDs (price_...). One per paid plan.
STRIPE_PRICE_PRO=
STRIPE_PRICE_ELITE=
# Where to redirect after Stripe Checkout resolves.
STRIPE_SUCCESS_URL=http://localhost:5173/billing/success
STRIPE_CANCEL_URL=http://localhost:5173/billing/cancel
# Included in 402 responses so the frontend knows where to send users.
BILLING_PUBLIC_UPGRADE_URL=http://localhost:5173/pricing

# ── SWE runtime (disposable-container code execution) — OFF by default ─────
# NEVER enable on the production daemon. Enable only on a non-production runner.
KAI_SWE_RUNTIME_ENABLED=0
# Absolute-path allowlist of source dirs the sandbox may run against (deny-by-default).
KAI_SWE_REPO_ALLOWLIST=
# Container images the sandbox may run (comma-separated).
KAI_SWE_IMAGE_ALLOWLIST=python:3.11-slim
KAI_SWE_MAX_WALL_SECONDS=120
KAI_SWE_MEMORY=512m
# Governance: running a task requires the scope AND approved=true.
# KAI_SCOPE_SWE_RUN=1
#
# ── Autonomous SWE agent (#42) scopes — enumerate INDIVIDUALLY. Do NOT set the
# KAI_SCOPE_SWE wildcard: it enables every swe.* action at once. The destructive
# push deliberately lives under a DISJOINT root (SWEPUSH), so the swe wildcard
# can never reach it.
# KAI_SCOPE_SWE_PLAN=1              # create a task + produce a plan (LLM only, no exec)
# KAI_SCOPE_SWE_BRAIN_EXECUTE=1    # Gate 1: run the bounded sandbox loop (destructive)
# KAI_SCOPE_SWEPUSH_EXECUTE=1      # Gate 2: apply + push to a review branch (destructive)
# Pending approvals older than this are refused at approve-time (→ 'expired').
KAI_SWE_APPROVAL_TIMEOUT_HOURS=24
