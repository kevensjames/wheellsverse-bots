# Copy this to .env and fill in real values.

# App
APP_NAME=Wheellsverse
APP_ENV=development
DEBUG=true

# Database — create with: createdb wheellsverse_dev
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wheellsverse_dev

# Redis (shared)
REDIS_URL=redis://localhost:6379/0

# JWT — generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=change_me_to_a_long_random_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Market data ingestion
MARKET_DATA_FETCH_INTERVAL_MINUTES=15
MARKET_DATA_LOOKBACK_DAYS=30
MARKET_DATA_BATCH_SIZE=10
YFINANCE_REQUEST_DELAY_SECONDS=0.5

# Predictions (Stage 4)
STOCK_PREDICTION_INTERVAL_MINUTES=60
CRYPTO_PREDICTION_INTERVAL_MINUTES=60
STOCK_PREDICTION_HORIZON_HOURS=24
CRYPTO_PREDICTION_HORIZON_HOURS=24
MIN_PRICE_HISTORY_ROWS=200
MODEL_VERSION=rules-v1

# Stripe billing (Stage 5) — use test-mode keys for local dev (sk_test_...)
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
# Create Products in Stripe → grab the Price IDs (price_...). One per paid plan.
STRIPE_PRICE_PRO=
STRIPE_PRICE_ELITE=
# Where to redirect after Stripe Checkout resolves.
STRIPE_SUCCESS_URL=http://localhost:5173/billing/success
STRIPE_CANCEL_URL=http://localhost:5173/billing/cancel
# Included in 402 responses so the frontend knows where to send users.
BILLING_PUBLIC_UPGRADE_URL=http://localhost:5173/pricing

# ─────────────────────────────────────────────────────────────────────────────
# KAI GOVERNANCE SCOPES  (@audited actions are OFF unless their scope is set)
# ─────────────────────────────────────────────────────────────────────────────
# Every destructive/governed admin action is wrapped in @audited(scope="x.y").
# If the matching env flag below is not truthy (1/true/yes), the action raises
# ScopeDenied -> HTTP 403 and silently no-ops. With NONE of these set, the whole
# operator console can READ but cannot DO anything (KG add-edge, planning,
# learning, twin, sol, refunds, etc. all 403).
#
# Granularity: a specific scope (KAI_SCOPE_KG_ADD_EDGE=1) enables exactly that
# action; a WILDCARD PARENT (KAI_SCOPE_KG=1) enables every KG.* action.
# Enable deliberately — these authorize real writes, money moves, and code/web
# actions. Leave money + browser-execute scopes OFF until you intend to use them.
#
# Read/low-risk subsystems (safe to enable to make the console functional):
KAI_SCOPE_KG=0                 # knowledge-graph add-edge (KG.add_edge)
KAI_SCOPE_BRIEFING=0           # operator briefing generate/daily
KAI_SCOPE_DIGEST=0             # cross-subsystem digest run
KAI_SCOPE_RESEARCH=0           # research run_cycle
KAI_SCOPE_LEARNING=0           # learning synthesize/activate/dismiss
KAI_SCOPE_PRESETS=0            # presets list
KAI_SCOPE_CHECKIN=0            # daily check-in
KAI_SCOPE_JOURNAL=0            # voice journal
KAI_SCOPE_PERSONA=0            # persona activate/archive
KAI_SCOPE_TWIN=0               # digital-twin suggest/draft/decide/activate/archive
KAI_SCOPE_PLANNING=0           # long-term planning create/draft/edit/approve/remediate/scout
#
# Higher-risk subsystems (enable only when you mean it):
KAI_SCOPE_SELF_HEAL=0          # bounded auto-fix allowlist
KAI_SCOPE_BROWSER_NAVIGATE=0   # browser-use read/navigate (allowlisted, SSRF-guarded)
KAI_SCOPE_BROWSER_PROPOSE=0    # browser-use propose a write sequence (still operator-approved)
KAI_SCOPE_BROWSER_EXECUTE=0    # browser-use EXECUTE approved writes — keep OFF unless actively using
#
# Money — keep OFF until compliance + facilitator agreement are in place:
KAI_SCOPE_SOL=0                # Sol ROSCA circle management (non-money ops)
KAI_SCOPE_SOL_TRANSFER=0       # Sol money movement (Dwolla) — sandbox-locked, double-gated
KAI_SCOPE_DWOLLA_CUSTOMER=0    # create Dwolla customers
KAI_SCOPE_DWOLLA_FUNDING=0     # attach funding sources
KAI_SCOPE_DWOLLA_TRANSFER=0    # initiate Dwolla transfers
KAI_SCOPE_STRIPE_REFUND=0      # issue Stripe refunds
