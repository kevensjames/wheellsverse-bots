# App B — KAI Celery WORKER — STAGING image.
#
# Identical to Dockerfile.staging (same FROM / deps / COPY, so BuildKit reuses the
# cached layers) EXCEPT the CMD runs the Celery worker instead of uvicorn. The worker
# serves no HTTP, so this service has NO healthcheck (Railway default = process-up).
# It does NOT run migrations — the API service owns `alembic upgrade head`.
FROM python:3.11

WORKDIR /app

COPY backend/requirements-staging.txt /tmp/backend-requirements.txt
RUN pip install --no-cache-dir -r /tmp/backend-requirements.txt \
 && pip install --no-cache-dir 'openai>=1.30.0,<2.0.0' 'anthropic>=0.39.0,<1.0.0'

COPY . /app

ENV PYTHONPATH=/app/backend

# Run via the entrypoint that ALSO binds $PORT (Railway stops portless containers).
# It starts a trivial health server + runs the Celery worker in-process (solo pool).
CMD ["python", "/app/backend/worker_entrypoint.py"]
