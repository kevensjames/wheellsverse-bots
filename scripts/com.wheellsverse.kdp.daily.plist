<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.wheellsverse.kdp.daily</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/jhonwheeler/wheellsverse_bots/.venv/bin/python</string>
        <string>/Users/jhonwheeler/wheellsverse_bots/scripts/daily_kdp_publish.py</string>
    </array>

    <!-- Run every day at 09:00 AM -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>9</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>WorkingDirectory</key>
    <string>/Users/jhonwheeler/wheellsverse_bots</string>

    <key>StandardOutPath</key>
    <string>/Users/jhonwheeler/wheellsverse_bots/logs/kdp_daily.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/jhonwheeler/wheellsverse_bots/logs/kdp_daily_error.log</string>

    <key>RunAtLoad</key>
    <false/>

    <key>KeepAlive</key>
    <false/>
</dict>
</plist>
