<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.wheellsverse.envdrift.weekly</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/jhonwheeler/wheellsverse_bots/.venv/bin/python</string>
        <string>/Users/jhonwheeler/wheellsverse_bots/scripts/check_env_drift.py</string>
    </array>

    <!-- Mondays at 09:13 (off-minute, off-hour to avoid the cron stampede) -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>1</integer>
        <key>Hour</key>
        <integer>9</integer>
        <key>Minute</key>
        <integer>13</integer>
    </dict>

    <key>WorkingDirectory</key>
    <string>/Users/jhonwheeler/wheellsverse_bots</string>

    <key>StandardOutPath</key>
    <string>/Users/jhonwheeler/wheellsverse_bots/logs/envdrift_weekly.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/jhonwheeler/wheellsverse_bots/logs/envdrift_weekly_error.log</string>

    <key>RunAtLoad</key>
    <false/>

    <key>KeepAlive</key>
    <false/>
</dict>
</plist>
