# ─── Shop Brand: @shop.wheellsverse (multi-account Meta) ─────────────────────
# Account name: "shop". Reads via env-prefix in core/instagram.py + core/facebook.py.
# Fill these AFTER creating the FB Page + IG Business pair and linking them.
# Get FACEBOOK_PAGE_TOKEN: developers.facebook.com → Tools → Graph API Explorer
# Get FACEBOOK_PAGE_ID: Meta Business Suite → Settings → Pages
# Get INSTAGRAM_ACCOUNT_ID: Meta Business Suite → Settings → Instagram → Account ID
SHOP_FACEBOOK_PAGE_TOKEN=
SHOP_FACEBOOK_PAGE_ID=
SHOP_FACEBOOK_PAGE_URL=
SHOP_FACEBOOK_EMAIL=
SHOP_FACEBOOK_PASSWORD=
SHOP_INSTAGRAM_PAGE_TOKEN=
SHOP_INSTAGRAM_ACCOUNT_ID=
SHOP_INSTAGRAM_USERNAME=
SHOP_INSTAGRAM_PASSWORD=

# ─── Shopify App Store (multi-tenant App on app.wheellsverse.com) ────────────
# Required for the merchant-facing Shopify App. Set on Railway, not here.
# See NARAI_SHOPIFY_APP_STORE.md for the full submission runbook.
#
# Get SHOPIFY_API_KEY + SHOPIFY_API_SECRET from your Shopify Partner dashboard
# after creating the app at https://partners.shopify.com → Apps → Create app.
# Note: SHOPIFY_API_KEY is also declared above for the single-merchant
# autopilot — same value works for both since it's the Partner client_id.
# MERCHANT_TOKEN_KEY: Fernet symmetric key for encrypting merchant access
# tokens at rest. Generate:
#   python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
MERCHANT_TOKEN_KEY=
# SHOPIFY_OAUTH_STATE_KEY: random hex used to sign the OAuth `state` nonce
# (CSRF protection). Generate:
#   python -c 'import secrets; print(secrets.token_hex(32))'
SHOPIFY_OAUTH_STATE_KEY=

# ─── Stripe billing (3 plan tiers + dedicated webhook) ───────────────────────
# Create 3 recurring products in Stripe → Products. Copy each price_... ID here.
STRIPE_PRICE_MERCHANT_STARTER=
STRIPE_PRICE_MERCHANT_PRO=
STRIPE_PRICE_MERCHANT_ELITE=
# Stripe → Developers → Webhooks → Add endpoint at /shopify/billing/webhook.
# Subscribe to: checkout.session.completed, customer.subscription.deleted,
# invoice.paid, invoice.payment_failed. Copy signing secret here.
STRIPE_MERCHANT_WEBHOOK_SECRET=
