# ============================================================
# WheellsVerse Bot Ecosystem — .env.example
# Copy this file to .env and fill in your values
# cp .env.example .env
# ============================================================

# ─── OpenAI ──────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o
OPENAI_MODEL_FAST=gpt-4o-mini

# ─── Email (Gmail SMTP) ───────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your@gmail.com
EMAIL_PASSWORD=your-app-password-here
EMAIL_FROM_NAME=WheellsVerse Bot

# ─── Shopify ─────────────────────────────────────────────────
SHOPIFY_STORE=your-store.myshopify.com
SHOPIFY_ACCESS_TOKEN=shpca_your_access_token_here
SHOPIFY_TOKEN=shpca_your_access_token_here

# ─── Printify ─────────────────────────────────────────────────
PRINTIFY_API_KEY=your_printify_api_token_here
PRINTIFY_SHOP_ID=your_printify_shop_id_here

# ─── Stripe ───────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_your_stripe_key
STRIPE_PUBLIC_KEY=pk_test_your_stripe_key

# ─── Twitter/X ────────────────────────────────────────────────
TWITTER_API_KEY=your_twitter_api_key
TWITTER_API_SECRET=your_twitter_api_secret
TWITTER_ACCESS_TOKEN=your_access_token
TWITTER_ACCESS_SECRET=your_access_token_secret
TWITTER_BEARER_TOKEN=your_bearer_token
# Browser automation (Playwright) — for auto-posting threads
TWITTER_EMAIL=your_twitter_email@gmail.com
TWITTER_PASSWORD=your_twitter_password
AUTO_POST_TWITTER=false

# ─── Instagram / Meta ─────────────────────────────────────────
INSTAGRAM_ACCESS_TOKEN=your_instagram_token
INSTAGRAM_ACCOUNT_ID=your_account_id

# ─── LinkedIn ─────────────────────────────────────────────────
LINKEDIN_ACCESS_TOKEN=your_linkedin_token
# Browser automation (Playwright) — for auto-posting
LINKEDIN_EMAIL=your_linkedin_email@gmail.com
LINKEDIN_PASSWORD=your_linkedin_password
AUTO_POST_LINKEDIN=false

# ─── Notion ───────────────────────────────────────────────────
NOTION_API_KEY=secret_your_notion_key
NOTION_DATABASE_ID=your_database_id

# ─── Slack ────────────────────────────────────────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token

# ─── Telegram ─────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# Telegram private-group subscription (see narai/integrations/TG_PRIVATE_GROUP_SETUP.md)
TELEGRAM_BOT_USERNAME=your_bot_username                # no @ prefix
TELEGRAM_PRIVATE_CHANNEL_ID=-1001234567890             # the -100... numeric id of the private channel
TELEGRAM_WEBHOOK_SECRET=                               # any random string; set in Telegram setWebhook
STRIPE_PRICE_TG_GROUP=price_XXXXXXXXXXXXXX             # recurring price id for the private group
STRIPE_WEBHOOK_SECRET=whsec_XXXXXXXXXXXXXX             # signing secret from Stripe → Webhooks
APP_BASE_URL=https://app.wheellsverse.com              # used to build success/cancel URLs

# ─── Google ───────────────────────────────────────────────────
GOOGLE_SHEETS_CREDENTIALS_PATH=./data/google_credentials.json
GOOGLE_ANALYTICS_PROPERTY_ID=your_property_id

# ─── CRM ──────────────────────────────────────────────────────
HUBSPOT_API_KEY=your_hubspot_key
AIRTABLE_API_KEY=your_airtable_key
AIRTABLE_BASE_ID=your_base_id

# ─── Search ───────────────────────────────────────────────────
SERPER_API_KEY=your_serper_key
SERPAPI_KEY=your_serpapi_key

# ─── System Settings ──────────────────────────────────────────
BOT_OUTPUT_DIR=./outputs
BOT_LOG_DIR=./logs
BOT_DATA_DIR=./data
TIMEZONE=America/New_York
LOG_LEVEL=INFO
DASHBOARD_PORT=5050
# API key to protect the dashboard (leave blank to disable auth)
API_KEY=

# ─── Your Business Info ───────────────────────────────────────
BUSINESS_NAME=WheellsVerse
BUSINESS_NICHE=AI & Automation
BUSINESS_WEBSITE=https://wheellsverse.com
OWNER_NAME=Jhon Kevens D Wheeler
BRAND_TONE=professional, bold, innovative
TARGET_AUDIENCE=entrepreneurs, investors, creators

# ─── TikTok Developer App ────────────────────────────────────
TIKTOK_CLIENT_KEY=your_tiktok_client_key
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret
TIKTOK_REDIRECT_URI=http://localhost:5050/api/tiktok/callback

# ─── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_your_stripe_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
# Get webhook secret: dashboard.stripe.com → Developers → Webhooks → Add endpoint
# Endpoint URL: https://your-domain.com/api/stripe/webhook
# Payment links for your Stripe products (replace with your real Stripe links)
STRIPE_BOT_PACK_URL=https://buy.stripe.com/your_bot_pack_link
STRIPE_PRO_URL=https://buy.stripe.com/your_pro_subscription_link

# ─── Reddit Automation ────────────────────────────────────────────────────────
# Create a "script" app at reddit.com/prefs/apps
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USERNAME=your_reddit_username
REDDIT_PASSWORD=your_reddit_password
REDDIT_USER_AGENT=WheellsVerse/1.0 by u/your_reddit_username

# ─── YouTube Data API v3 ──────────────────────────────────────────────────────
# 1. Go to console.cloud.google.com → New project → Enable "YouTube Data API v3"
# 2. Create OAuth 2.0 credentials (Desktop app) → Download JSON
# 3. Save as data/youtube_client_secret.json
# 4. Run: python -m core.youtube auth
YOUTUBE_CLIENT_SECRET_FILE=data/youtube_client_secret.json

# ─── Telegram Bot ─────────────────────────────────────────────────────────────
# 1. Message @BotFather on Telegram → /newbot → copy token below
# 2. Message @userinfobot → copy your numeric chat ID below
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_numeric_chat_id

# ─── Impact.com Affiliate Earnings ───────────────────────────────────────────
# Get from: app.impact.com → Settings → API → Account SID + Auth Token
# Account SID is your publisher ID (e.g. 7117979)
IMPACT_ACCOUNT_SID=your_impact_account_sid
IMPACT_API_PASSWORD=your_impact_api_password

# ─── Site & Publishing ────────────────────────────────────────────────────────
# Your live site URL — used in tracking links and published blog posts
CTA_URL=https://wheellsverse-bots.pages.dev

# ─── Daily Auto-Publish ───────────────────────────────────────────────────────
# Time to run daily publish (24h format, local timezone)
DAILY_PUBLISH_TIME=08:00
# Number of posts to generate per daily run
DAILY_POSTS_COUNT=5

# ─── ConvertKit ───────────────────────────────────────────────────────────────
# Optional: Create a sequence in ConvertKit → paste its ID here to auto-enroll leads
# If not set, drip emails are created as broadcast drafts instead
CONVERTKIT_DRIP_SEQUENCE_ID=

# ─── Affiliate Links (replace with YOUR unique referral links) ────────────────
AFFILIATE_AMAZON_TAG=wheellsverse-20
AFFILIATE_AMAZON_TAG_2=naraiinsights-20
AFFILIATE_AMAZON_VIDEO_URL=https://www.amazon.com/gp/video/storefront?&linkCode=ll2&tag=naraiinsights-20&linkId=1e7be931abc50f1b8c8adb1ffc1b0827&language=en_US&ref_=as_li_ss_tl
AFFILIATE_COINBASE_URL=https://coinbase.com/join/your_ref
AFFILIATE_ROBINHOOD_URL=https://join.robinhood.com/your_ref
AFFILIATE_BINANCE_URL=https://accounts.binance.com/register?ref=your_ref
AFFILIATE_CONVERTKIT_URL=https://convertkit.com?lmref=your_ref
AFFILIATE_JASPER_URL=https://jasper.ai?fpr=your_ref
AFFILIATE_BLUEHOST_URL=https://bluehost.com/track/your_ref
AFFILIATE_FIVERR_URL=https://fvrr.co/your_ref
AFFILIATE_CLICKBANK_URL=https://your_cb_link.com
AFFILIATE_APPSUMO_URL=https://appsumo.com?ref=your_ref

# ─── Anthropic / Claude API ─────────────────────────────────────────────────
# Used by Agent Workforce, Prompt Intel, SEO Autopilot, and Receptionist bots
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
CLAUDE_MODEL=claude-sonnet-4-20250514

# ─── Twilio (Receptionist Bots — Voice + SMS) ───────────────────────────────
# 1. Sign up at twilio.com → copy Account SID + Auth Token
# 2. Buy a phone number → paste below
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# ─── SendGrid (Email Receptionist Bot) ──────────────────────────────────────
SENDGRID_API_KEY=SG.your_sendgrid_api_key
SENDGRID_FROM_EMAIL=noreply@wheellsverse.com

# ─── Hunter.io (Affiliate Scout — Email Validation) ─────────────────────────
HUNTER_API_KEY=your_hunter_api_key

# ─── WordPress (SEO Autopilot — Publishing) ──────────────────────────────────
# Only needed if publishing articles to WordPress
WORDPRESS_URL=https://your-wordpress-site.com
WORDPRESS_USER=your_wp_user
WORDPRESS_APP_PASS=your_wp_application_password

# ─── DataForSEO (SEO Bots — Keyword Research) ───────────────────────────────
# Optional: used for rank tracking and keyword research
DATAFORSEO_LOGIN=your_dataforseo_login
DATAFORSEO_PASSWORD=your_dataforseo_password

# ─── WhatsApp Business API ───────────────────────────────────────────────────
WHATSAPP_VERIFY_TOKEN=wheellsverse_whatsapp
WHATSAPP_ACCESS_TOKEN=your_whatsapp_permanent_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
# Optional: auto-reply text sent to every incoming message (leave empty to disable)
WHATSAPP_AUTO_REPLY=Thanks for reaching out to WheellsVerse! We'll get back to you shortly.

# ─── HeyGen Video Generation ─────────────────────────────────────────────────
HEYGEN_API_KEY=your_heygen_api_key
HEYGEN_AVATAR_ID=your_avatar_id
HEYGEN_VOICE_ID=your_voice_id

# ─── AI Image Generation (Cover Engine + Media Engine) ───────────────────────
# DALL·E 3 — uses your OPENAI_API_KEY above (no extra key needed)
# ~$0.04/image (standard) | ~$0.08/image (HD) | platform.openai.com/api-keys

# Leonardo AI — free tier: 150 tokens/day (~15 images), great 3D quality
# 1. Sign up at leonardo.ai → 2. Go to leonardo.ai/api → Get API Key
LEONARDO_API_KEY=your_leonardo_api_key_here

# Midjourney — NO API. NarAI generates the prompt; paste it into Discord manually.
# Prompt is saved in every product package under cover_prompts.midjourney

# ─── AI Video Generation (Media Engine — product showcase animations) ─────────
# Runway ML Gen-3 Alpha Turbo — image-to-video, ~$0.05/second
# 1. Sign up at runwayml.com → 2. API → Create API key
# docs: https://docs.runwayml.com
RUNWAY_API_KEY=your_runway_api_key_here

# Luma AI Dream Machine — alternative video generator (text/image-to-video)
# 1. Sign up at lumalabs.ai → 2. API Access → Generate key
# docs: https://docs.lumalabs.ai/dream-machine
LUMAAI_API_KEY=your_lumaai_api_key_here

# ─── Store Intelligence ───────────────────────────────────────────────────────
# No extra keys needed — uses your Shopify access token above.
# Automatically analyses your store every session to find fast-selling gaps.

# ─── WheellsVerse Platform ───────────────────────────────────────────────────
# API key for the WheellsVerse dashboard (set any secret string)
NARAI_API_KEY=your-narai-api-key-here
# Absolute path to this project root (used by code_engine and bot_manager)
WHEELLSVERSE_PATH=/Volumes/Wheellsverse/wheellsverse_bots
# Model used by code_engine for code generation (defaults to CLAUDE_MODEL if unset)
CODE_ENGINE_MODEL=claude-sonnet-4-20250514

# ─── NarAI Voice ─────────────────────────────────────────────────────────────
VOICE_ENABLED=true
TTS_PROVIDER=browser
ELEVENLABS_API_KEY=your_elevenlabs_key_here
ELEVENLABS_VOICE_ID=your_cloned_voice_id      # from elevenlabs.io → Voices → your clone

# ─── Zoom AI Clone ────────────────────────────────────────────────────────────
ZOOM_CLIENT_ID=your_zoom_oauth_client_id
ZOOM_CLIENT_SECRET=your_zoom_oauth_client_secret
ZOOM_ACCOUNT_ID=your_zoom_account_id
DEEPGRAM_API_KEY=your_deepgram_api_key        # for live speech-to-text in meetings
CLONE_USER_ID=your_supabase_user_id           # whose memory/personality the clone uses
# VIRTUAL_AUDIO_SINK=pulse                    # Linux only: pulseaudio virtual sink name

# ─── NarAI Search ────────────────────────────────────────────────────────────
SEARCH_ENABLED=true

# ─── NarAI Chat DB ───────────────────────────────────────────────────────────
DB_PATH=data/narai_chat.db
UPLOAD_PATH=uploads/

