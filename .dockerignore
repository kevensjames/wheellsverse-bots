# Secrets — never bake into the image (pass via Railway/Render env vars)
.env
.env.*
*.env.local
*.pem
*.key
*_secret*
*credentials*

# Virtual environment (rebuilt inside container)
venv/
.venv/
env/

# Python cache
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
dist/
build/

# Generated data (use mounted volumes in production)
outputs/
logs/
data/leads/
data/intelligence.json
data/strategy.json

# NarAI runtime state — never overwrite live data on deploy
# (skill Python files and narai_skills.json ARE deployed — they're code, not state)
data/narai_memory.json
data/wa_inbox.json
data/wa_schedule.json
data/wa_contacts.json

# macOS / IDE noise
.DS_Store
.vscode/
.idea/
*.swp
*.swo

# Git
.git/
.gitignore

# Docker build files
.dockerignore
compose*.yaml

# Large local-only directories
.claude/
.venv/
venv/
node_modules/
*.zip
*.tar.gz
*.mp4
*.mp3
*.wav

# money_center — operator workstation tooling, never served by either deployed app.
# It holds the only shell=True subprocess calls in the repository, fed by an unvalidated form field
# with no authentication in front of it. Nothing deployed imports it and no deployment artifact has
# ever started it, but the Dockerfile is `COPY . .`, so without this the vulnerable source shipped
# inside the production image — dormant, and a convenience for anyone who gets execution by another
# route. assets.json and config.yaml are deliberately NOT excluded: GET /api/money/assets reads the
# JSON at runtime, and data is not a sink.
money_center/*.py
money_center/tests/
