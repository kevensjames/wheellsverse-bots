# wheellsverse-kai tunnel config — TEMPLATE.
# Copy to ~/.cloudflared/config.yml on a fresh deployment, fill in the
# placeholders, and `cloudflared tunnel route dns <tunnel-name> <hostname>`.
# Supervised by deploy/launchd/com.wheellsverse.cloudflared.plist.
tunnel: <TUNNEL-UUID-from-`cloudflared tunnel create wheellsverse-kai`>
credentials-file: /Users/<USER>/.cloudflared/<TUNNEL-UUID>.json

ingress:
  - hostname: kai.wheellsverse.com
    service: http://127.0.0.1:8001
    originRequest:
      noTLSVerify: true
      disableChunkedEncoding: false
  # Legacy hostname kept during the NAI→KAI rename; drop once nothing points at it.
  - hostname: nai.wheellsverse.com
    service: http://127.0.0.1:8001
    originRequest:
      noTLSVerify: true
      disableChunkedEncoding: false
  - service: http_status:404
