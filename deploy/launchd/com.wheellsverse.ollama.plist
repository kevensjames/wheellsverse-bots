<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
Ollama LaunchAgent.

This is the bring-your-own alternative to `brew services start ollama` for
when Ollama wasn't installed via Homebrew. On this Mac mini, `which ollama`
returns /usr/local/bin/ollama (manual install), which is why we ship a
custom plist rather than relying on Homebrew's.

Install:
    cp deploy/launchd/com.wheellsverse.ollama.plist ~/Library/LaunchAgents/
    launchctl load -w ~/Library/LaunchAgents/com.wheellsverse.ollama.plist

Verify:
    curl -sf http://127.0.0.1:11434/api/tags | jq '.models[].name'
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.wheellsverse.ollama</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/ollama</string>
        <string>serve</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>EnvironmentVariables</key>
    <dict>
        <key>OLLAMA_HOST</key>
        <string>127.0.0.1:11434</string>
        <key>OLLAMA_KEEP_ALIVE</key>
        <string>30m</string>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/jhonwheeler/Library/Logs/wheellsverse/ollama.stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/jhonwheeler/Library/Logs/wheellsverse/ollama.stderr.log</string>
</dict>
</plist>
