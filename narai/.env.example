# ── NarAI environment variables ───────────────────────────────────────────────
# Copy to .env (already exists in monorepo root) and fill in values.
# Never commit .env.

# ── AI Models ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=               # Claude — primary model. Cost: ~$3/M input tokens (Sonnet)
OPENAI_API_KEY=                  # GPT fallback. Cost: ~$5/M input tokens (GPT-4o)
# Ollama runs locally, no API key needed — free

NARAI_DEEP_MODEL=claude/claude-sonnet-4-6
NARAI_FAST_MODEL=claude/claude-haiku-4-5-20251001

# ── Database ──────────────────────────────────────────────────────────────────
# Dev: leave empty → uses SQLite at narai/data/narai.db
NARAI_DATABASE_URL=
# Prod: postgresql+asyncpg://narai:password@localhost:5432/narai
POSTGRES_PASSWORD=

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate: python -c "from passlib.hash import bcrypt; print(bcrypt.hash('yourpassword'))"
NARAI_PASSWORD_HASH=
NARAI_JWT_SECRET=change-me-to-a-random-256-bit-string
NARAI_JWT_TTL_HOURS=72

# ── Encrypted Storage ─────────────────────────────────────────────────────────
NARAI_STORAGE_KEY=               # Any long random string — used to derive Fernet key

# ── Vector DB ─────────────────────────────────────────────────────────────────
# Leave empty → defaults to narai/data/chroma
NARAI_CHROMA_PATH=
NARAI_EMBED_MODEL=all-MiniLM-L6-v2   # Local, free, Apple Silicon friendly

# ── Server ────────────────────────────────────────────────────────────────────
NARAI_PORT=5051
NARAI_ENV=dev                        # dev enables /docs; prod disables it
NARAI_CORS_ORIGINS=http://localhost:5050,http://localhost:5051

# ── RAG chunking ──────────────────────────────────────────────────────────────
NARAI_CHUNK_SIZE=512
NARAI_CHUNK_OVERLAP=64

# ── Paid APIs (flag cost per service) ─────────────────────────────────────────
SERPER_API_KEY=                  # Google Search via Serper. Cost: $50/5K queries
ALPACA_API_KEY=                  # Stock trading. Cost: free for paper trading
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets  # paper by default — NEVER change to live without explicit opt-in
BINANCE_API_KEY=                 # Crypto. Cost: free tier available
BINANCE_SECRET_KEY=
