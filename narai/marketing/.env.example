# NarAI Marketing Autopilot — Environment Variables
# Copy this to .env and fill in your values

# ── Core ─────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# Launch date for day calculation (format: YYYY-MM-DD)
LAUNCH_DATE=2026-05-01

# Set to true to automatically post content to Instagram/Facebook after generation
AUTO_POST=false

# ── Meta (Instagram + Facebook) ───────────────────────────────────────────────
# Get from Meta Business Manager → System Users → Generate Token
INSTAGRAM_PAGE_TOKEN=
INSTAGRAM_ACCOUNT_ID=

FACEBOOK_PAGE_TOKEN=
FACEBOOK_PAGE_ID=

# ── Gumroad ───────────────────────────────────────────────────────────────────
# Settings → Advanced → Applications → Generate access token
GUMROAD_ACCESS_TOKEN=

# ── ConvertKit ────────────────────────────────────────────────────────────────
CONVERTKIT_API_KEY=
CONVERTKIT_API_SECRET=
CONVERTKIT_FORM_ID=

# ── Email / SMTP ──────────────────────────────────────────────────────────────
# For Gmail: use an App Password (not your account password)
# https://myaccount.google.com/apppasswords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=wheelerjhonkevensd@gmail.com
EMAIL_PASSWORD=

# Where to send daily digests
NOTIFY_EMAIL=wheelerjhonkevensd@gmail.com
